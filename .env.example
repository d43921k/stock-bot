# 複製這個檔案為 .env，並填入你自己的金鑰
# 到 https://aistudio.google.com/apikey 免費申請 Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# 使用的 Gemini 模型（可視額度/可用性調整）
GEMINI_MODEL=gemini-3.5-flash

# Gemini 忙碌（503）時的備援方案：Groq（免費、幾乎不過載）
# 到 https://console.groq.com/keys 免費申請（不需信用卡）
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 新聞搜尋關鍵字（Google 新聞 RSS）
NEWS_QUERY=台股 大盤

# 要抓取的新聞則數
NEWS_LIMIT=10

# 晨報輸出路徑（預設輸出到 docs/ 供 GitHub Pages 使用）
REPORT_OUTPUT_PATH=docs/index.html
